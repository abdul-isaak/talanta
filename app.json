{
  "expo": {
    "name": "Talanta",
    "slug": "Talanta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talanta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a2540"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Talanta",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a2540"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Talanta needs access to your photos and videos so you can upload highlight clips for scouts and AI analysis.",
          "cameraPermission": "Talanta uses the camera so you can record highlight videos of your skills.",
          "microphonePermission": "Talanta records audio with your highlight videos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ac5c64d-0918-4905-89f9-96c0f5192c5b"
      }
    },
    "owner": "dulkaka",
    "backgroundColor": "#0d1b2a"
  }
}
